#!/usr/bin/env bash
#
# Fake AWS CLI for the script test harness (§11.5).
#
# Placed earlier on PATH than the real CLI so that a script under test cannot
# reach a real account even if its arguments are wrong. That containment is what
# makes it safe to run mutating-script tests in CI, and why §11.5 requires the
# harness rather than "careful" tests against a scratch account.
#
# Behaviour: responds to the read calls the scripts make, and records every
# mutating call to $FAKE_AWS_LOG so a test can assert that --apply performed
# exactly what --dry-run described. That assertion is the point of the harness —
# a dry-run that lies is worse than no dry-run.
set -euo pipefail

LOG="${FAKE_AWS_LOG:-/dev/null}"
STATE="${FAKE_AWS_STATE:-}"
# FAKE_AWS_STATE is one document for every call, which is enough for a script that
# reads one thing. cleanup-aws.sh reads three different shapes — the stack list, each
# stack's resources, and the tag query — and its safety argument is precisely about how
# those three disagree, so it needs them answered separately. FAKE_AWS_FIXTURES is a
# colon-separated search path of directories holding one file per operation; see below.
FIXTURES="${FAKE_AWS_FIXTURES:-}"

# Strip the global flags the scripts pass so the service/operation parse below
# does not have to account for them.
ARGS=()
while [ $# -gt 0 ]; do
    case "$1" in
        --region|--profile|--output) shift 2 ;;
        --no-cli-pager) shift ;;
        *) ARGS+=("$1"); shift ;;
    esac
done
set -- "${ARGS[@]:-}"

SERVICE="${1:-}"
OPERATION="${2:-}"

# Any call that is not an explicit read is logged as a mutation. Defaulting to
# "this changed something" is the safe direction: an unrecognised call being
# treated as read-only would let a real mutation pass a test silently.
case "$OPERATION" in
    get-*|describe-*|list-*|head-*) : ;;
    *) printf '%s %s %s\n' "$SERVICE" "$OPERATION" "$*" >> "$LOG" ;;
esac

# FAKE_AWS_UNREADABLE models an API that fails: a space-separated list of substrings
# matched against the whole invocation, so a test can fail one operation
# ("cloudformation:describe-stacks") or one resource ("passbook-prod") while everything
# else answers normally.
#
# Needed because the interesting behaviour of a sweep is what it does when it CANNOT see
# something. A script that fails closed on an unreadable inventory and one that treats it
# as "nothing is claimed" are indistinguishable on a healthy account, and the difference
# between them is the live deployment.
if [ -n "${FAKE_AWS_UNREADABLE:-}" ]; then
    read -ra FAKE_AWS_UNREADABLE_PATTERNS <<<"$FAKE_AWS_UNREADABLE"
    for pattern in ${FAKE_AWS_UNREADABLE_PATTERNS[@]+"${FAKE_AWS_UNREADABLE_PATTERNS[@]}"}; do
        case "$SERVICE:$OPERATION $*" in
            *"$pattern"*)
                echo "An error occurred (AccessDeniedException) when calling the ${OPERATION} operation: simulated by FAKE_AWS_UNREADABLE" >&2
                exit 254
                ;;
        esac
    done
fi

# Per-operation fixtures, checked before the built-in responses so a test can override
# any of them: <dir>/<service>-<operation>.json is returned verbatim.
#
# FAKE_AWS_FIXTURES is a colon-separated SEARCH PATH, first match wins, so a scenario
# directory overrides one operation and inherits every other response from a base
# directory behind it. That is not convenience — a scenario that has to restate every
# response is how "right exit code, wrong reason" gets into a test suite: the response
# nobody restated answers `{}`, the script under test refuses on an unrelated branch,
# and the test keeps passing after the guard it was written for is deleted. Two of the
# cleanup-aws refusal tests did exactly that before this was a search path.
#
# A MISSING file is still deliberately not an error — it falls through to the default
# `{}`, which is what lets a test model "this API could not be read" by omitting the
# fixture. Prefer FAKE_AWS_UNREADABLE for that now: it says so explicitly.
if [ -n "$FIXTURES" ]; then
    IFS=: read -ra FAKE_AWS_FIXTURE_DIRS <<<"$FIXTURES"
    for dir in ${FAKE_AWS_FIXTURE_DIRS[@]+"${FAKE_AWS_FIXTURE_DIRS[@]}"}; do
        if [ -f "${dir}/${SERVICE}-${OPERATION}.json" ]; then
            cat "${dir}/${SERVICE}-${OPERATION}.json"
            exit 0
        fi
    done
fi

case "$SERVICE:$OPERATION" in
    sts:get-caller-identity)
        # Deliberately NOT root: the harness models the agent principal the
        # guardrails assume, so a test cannot accidentally assert against a root
        # identity that §9.4 forbids.
        echo '{"UserId":"AIDAFAKE","Account":"000000000000","Arn":"arn:aws:iam::000000000000:role/voicenotes-agent"}'
        ;;
    iam:get-role)
        echo '{"Role":{"RoleName":"voicenotes-agent","PermissionsBoundary":{"PermissionsBoundaryArn":"arn:aws:iam::000000000000:policy/voicenotes-agent-boundary"}}}'
        ;;
    iam:list-roles) echo '{"Roles":[]}' ;;
    iam:get-open-id-connect-provider) exit 255 ;;
    cloudtrail:list-trails) echo '{"Trails":[{"Name":"voicenotes-trail"}]}' ;;
    ssm:get-parameter)
        # Returns metadata only, never a value: the agent must not read a
        # secret's value, only confirm the parameter exists (§9.4).
        echo '{"Parameter":{"Name":"fake","Type":"SecureString"}}'
        ;;
    ce:list-cost-allocation-tags)
        echo '{"CostAllocationTags":[{"TagKey":"Project","Status":"Active"}]}'
        ;;
    dynamodb:*|s3:*|s3api:*|cloudformation:*|lambda:*|logs:*|cognito-idp:*)
        [ -n "$STATE" ] && [ -f "$STATE" ] && cat "$STATE" || echo '{}'
        ;;
    *) echo '{}' ;;
esac
